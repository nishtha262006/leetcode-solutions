class Solution {
public:
    int maxSum(vector<int>& nums, int k) {
        const int MOD = 1e9 + 7;
        int cnt[31] = {0};

        // Count how many numbers contain each set bit
        for (int x : nums) {
            for (int i = 0; i < 31; i++) {
                if (x & (1 << i)) {
                    cnt[i]++;
                }
            }
        }

        long long ans = 0;

        // Construct k numbers with as many set bits as possible
        while (k--) {
            int x = 0;

            for (int i = 0; i < 31; i++) {
                if (cnt[i] > 0) {
                    x |= (1 << i);
                    cnt[i]--;
                }
            }

            ans = (ans + 1LL * x * x) % MOD;
        }

        return ans;
    }
};
